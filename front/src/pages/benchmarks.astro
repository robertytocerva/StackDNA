---
import '../styles/global.css';
import '../styles/benchmarks.css';
import SharedHeader from '../components/shared/Header.astro';
import StatGrid from '../components/Benchmark/StatGrid.astro';
import Podium3D from '../components/Benchmark/Podium3D.astro';
import StackCard from '../components/Benchmark/StackCard.astro';
import ModelModal from '../components/Benchmark/ModelModal.astro';
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>StackADN // AI Models Benchmark</title>
  <link rel="icon" type="image/png" href="/LogoStackDNA.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>

  <SharedHeader />

  <main style="max-width: 1180px; margin: 0 auto; padding: 100px 32px 40px;">

    <section style="margin-bottom: 3rem;">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight" style="letter-spacing:-0.03em; margin-bottom: 1rem;">
        El <span style="background:linear-gradient(135deg,var(--accent-bright),var(--accent));-webkit-background-clip:text;background-clip:text;color:transparent">Matching Genético</span> de cada modelo de IA.
      </h1>
      <p class="text-base max-w-2xl" style="color:var(--fg-dim); margin-bottom: 1.5rem;">
        Comparativa técnica en tiempo real: calidad, throughput, latencia y pricing. 
        Sin marketing. Solo métricas que importan cuando eliges un modelo para producción.
      </p>
      <div id="freshnessBadge" class="freshness-badge">
        <span class="freshness-dot"></span>
        <span id="freshnessText">SYNCING…</span>
      </div>
    </section>

    <StatGrid />
    <Podium3D />
    <StackCard />
    <ModelModal />

  </main>

  <footer class="bench-footer">
    <span>STACKADN · Construido para ingenieros, no para marketing.</span>
    <a href="https://artificialanalysis.ai" target="_blank" rel="noopener" class="bench-footer-source">
      Fuente de datos: artificialanalysis.ai ↗
    </a>
  </footer>

  <script src="../scripts/benchmarks.ts"></script>
</body>
</html>
