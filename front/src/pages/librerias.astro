---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FilterBar from '../components/FilterBar/FilterBar.astro';
import LanguageSection from '../components/LanguageSection/LanguageSection.astro';
import SearchBar from '../components/SearchBar/SearchBar.astro';
import Layout from '../layouts/Layout.astro';
import { libraries, type LibraryEntry } from '../data/libraries';
import { useLibraryFilter } from '../hooks/useLibraryFilter';
import '../styles/librerias.css';

const initialFilters = useLibraryFilter(libraries, '', 'all', 'all');
const languageOptions = initialFilters.availableLanguages.map((language) => ({
	value: language,
	label: language,
	icon: libraries.find((item) => item.language === language)?.languageIcon ?? '/favicon.svg',
}));
const totalLanguages = new Set(libraries.map((item) => item.language)).size;
const totalLibraries = libraries.length;
const groupedLibraries = initialFilters.filteredData.reduce<Record<string, LibraryEntry[]>>((groups, item) => {
	(groups[item.language] ??= []).push(item);
	return groups;
}, {});
---

<Layout
	title="Librerías — StackDNA"
	description="Explora ejemplos prácticos de librerías para Python, JavaScript y Java."
>
	<div class="bg-noise" aria-hidden="true"></div>
	<Header />
	<main class="library-page" data-library-app data-selected-language="all" data-selected-category="all">
		<section class="library-hero">
			<div class="wrap library-hero-grid">
				<div class="library-hero-copy">
					<span class="library-eyebrow"><span class="eyebrow-dot"></span> STACKDNA / LIBRARIES</span>
					<h1>Encuentra la pieza exacta de tu <span class="accent">stack.</span></h1>
					<p>
						Una biblioteca curada de herramientas reales para pasar de “sé que existe” a
						“sé cómo usarla” en menos de un minuto.
					</p>
				</div>
				<div class="library-signal" aria-label={`${totalLanguages} lenguajes y ${totalLibraries} librerías disponibles`}>
					<div class="signal-orbit signal-orbit-one"></div>
					<div class="signal-orbit signal-orbit-two"></div>
					<div class="signal-core"><span>DNA</span></div>
					<div class="signal-label signal-label-top">INDEX / 001</div>
					<div class="signal-label signal-label-bottom">LIVE CATALOG</div>
				</div>
			</div>
		</section>

		<section class="library-workbench wrap" aria-labelledby="library-heading">
			<div class="workbench-shell">
				<div class="workbench-heading">
					<div>
						<span class="section-tag">Catálogo de referencia</span>
						<h2 id="library-heading">Explora por intención, no por ruido.</h2>
						<p>Busca una función, filtra por lenguaje y llega directo a un ejemplo que puedas adaptar.</p>
					</div>
					<div class="catalog-count" aria-label={`${totalLanguages} lenguajes y ${totalLibraries} librerías`}>
						<strong>{String(totalLibraries).padStart(2, '0')}</strong>
						<span>librerías<br />indexadas</span>
					</div>
				</div>

				<SearchBar resultCount={initialFilters.totalResults} />
				<FilterBar
					languages={languageOptions}
					categories={initialFilters.availableCategories}
					selectedLanguage="all"
					selectedCategory="all"
				/>

				<div class="library-results" id="library-results" aria-live="polite">
					{Object.entries(groupedLibraries).map(([language, languageLibraries]) => (
						<LanguageSection
							language={language}
							libraries={languageLibraries}
							languageIcon={languageLibraries[0]?.languageIcon ?? '/favicon.svg'}
						/>
					))}
					<div class="empty-state" data-empty-state hidden>
						<span class="empty-icon" aria-hidden="true">⌕</span>
						<div>
							<span class="placeholder-kicker">NO_MATCH / 404</span>
							<p>No encontramos librerías con ese criterio.</p>
							<span>Intenta con otro término o limpia los filtros.</span>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<script>
	import { libraries } from '../data/libraries';
	import { useLibraryFilter } from '../hooks/useLibraryFilter';

	const app = document.querySelector<HTMLElement>('[data-library-app]');

	if (app) {
		const searchInput = app.querySelector<HTMLInputElement>('[data-library-search]');
		const clearButton = app.querySelector<HTMLButtonElement>('[data-clear-search]');
		const resultCount = app.querySelector<HTMLElement>('[data-results-count]');
		const emptyState = app.querySelector<HTMLElement>('[data-empty-state]');
		const cards = Array.from(app.querySelectorAll<HTMLElement>('[data-library-card]'));
		const languageSections = Array.from(app.querySelectorAll<HTMLElement>('[data-language-section]'));
		let selectedLanguage = app.dataset.selectedLanguage ?? 'all';
		let selectedCategory = app.dataset.selectedCategory ?? 'all';
		let debounceTimer: ReturnType<typeof setTimeout> | undefined;

		const updateResults = () => {
			const { filteredData, totalResults } = useLibraryFilter(
				libraries,
				searchInput?.value ?? '',
				selectedLanguage,
				selectedCategory as 'all' | (typeof libraries[number]['library']['category']),
			);
			const resultLabel = totalResults === 1 ? 'resultado encontrado' : 'resultados encontrados';
			const visibleIds = new Set(filteredData.map((item) => item.id));

			if (resultCount) resultCount.textContent = `${totalResults} ${resultLabel}`;
			if (clearButton) clearButton.hidden = (searchInput?.value.length ?? 0) === 0;
			if (emptyState) emptyState.hidden = totalResults !== 0;

			cards.forEach((card) => {
				card.hidden = !visibleIds.has(card.dataset.libraryId ?? '');
			});
			languageSections.forEach((section) => {
				section.hidden = !section.querySelector('[data-library-card]:not([hidden])');
			});

			app.querySelectorAll<HTMLButtonElement>('[data-filter-language]').forEach((button) => {
				const isActive = button.dataset.filterLanguage === selectedLanguage;
				button.classList.toggle('active', isActive);
				button.setAttribute('aria-pressed', String(isActive));
			});
			app.querySelectorAll<HTMLButtonElement>('[data-filter-category]').forEach((button) => {
				const isActive = button.dataset.filterCategory === selectedCategory;
				button.classList.toggle('active', isActive);
				button.setAttribute('aria-pressed', String(isActive));
			});
		};

		searchInput?.addEventListener('input', () => {
			if (debounceTimer) clearTimeout(debounceTimer);
			debounceTimer = setTimeout(updateResults, 300);
		});

		clearButton?.addEventListener('click', () => {
			if (!searchInput) return;
			searchInput.value = '';
			searchInput.focus();
			updateResults();
		});

		app.querySelectorAll<HTMLButtonElement>('[data-filter-language]').forEach((button) => {
			button.addEventListener('click', () => {
				selectedLanguage = button.dataset.filterLanguage ?? 'all';
				app.dataset.selectedLanguage = selectedLanguage;
				updateResults();
			});
		});

		app.querySelectorAll<HTMLButtonElement>('[data-filter-category]').forEach((button) => {
			button.addEventListener('click', () => {
				selectedCategory = button.dataset.filterCategory ?? 'all';
				app.dataset.selectedCategory = selectedCategory;
				updateResults();
			});
		});
	}
</script>
