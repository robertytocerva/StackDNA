---
import Logo from './Logo.astro';

const homeHref = (anchor: string) => (Astro.url.pathname === '/' ? anchor : `/${anchor}`);
const columns = [
	{ title: 'Producto', links: [{ href: homeHref('#features'), label: 'Features' }, { href: '/librerias', label: 'Librerias' }, { href: '/servicios', label: 'API Tester' }, { href: '/terms', label: 'Terminos de uso' }] },
	{ title: 'Compania', links: [{ href: '/equipo', label: 'Equipo' },  { href: homeHref('https://github.com/robertytocerva/StackDNA'), label: 'Documentacion' },] },
	{ title: 'Recursos', links: [{ href: homeHref('#faq'), label: 'FAQ' }, { href: homeHref('https://github.com/robertytocerva/StackDNA'), label: 'GitHub' }] },
];
---

<footer class="site-footer">
	<div class="wrap">
		<div class="footer-grid">
			<div class="footer-brand">
				<div class="logo">
					<Logo width={46} height={24} pairs={4} class="logo-helix" />
					StackDNA
				</div>
				<p>El perfil genetico de tu stack: dependencias, arquitectura y seguridad en un solo mapa.</p>
			</div>
			<div class="footer-links">
				{columns.map((column) => (
					<div class="footer-col">
						<h4>{column.title}</h4>
						{column.links.map((link) => <a href={link.href}>{link.label}</a>)}
					</div>
				))}
			</div>
		</div>
		<div class="footer-bottom">
			<span>© 2026 StackDNA. Todos los derechos reservados.</span>
			<span>Hecho para developers, no para dashboards.</span>
		</div>
	</div>
</footer>
