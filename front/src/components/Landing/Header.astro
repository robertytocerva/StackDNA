---
const homeHref = (anchor: string) => (Astro.url.pathname === '/' ? anchor : `/${anchor}`);
const links = [
	{ href: homeHref('#producto'), label: 'Producto' },
	{ href: homeHref('#features'), label: 'Features' },
	{ href: '/equipo', label: 'Equipo' },
	//{ href: homeHref('#precios'), label: 'Precios' },
	{ href: homeHref('#faq'), label: 'FAQ' },
	{ href: '/librerias', label: 'Librerías' },
	{ href: '/servicios', label: 'API Tester' },
];
---

<header class="site-header">
	<nav class="site-nav" aria-label="Navegacion principal">
		<div class="logo">
      		<span class="logo-mark">
        		<svg viewBox="0 0 24 24" fill="none">
          			<path d="M6 2C6 6 18 6 18 10C18 14 6 14 6 18C6 22 18 22 18 22" stroke="url(#g1)" stroke-width="2" stroke-linecap="round"/>
          		<defs><linearGradient id="g1" x1="0" y1="0" x2="24" y2="24"><stop stop-color="#a78bfa"/><stop offset="1" stop-color="#7c3aed"/></linearGradient></defs>
        	</svg>
      	</span>
      StackDNA
    </div>
		<div class="nav-links">
			{links.map((link) => <a href={link.href}>{link.label}</a>)}
		</div>
		<a href={homeHref('#precios')} class="nav-cta">$ npx stackdna init</a>
	</nav>
</header>
