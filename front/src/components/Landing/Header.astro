---
import Logo from './Logo.astro';

const homeHref = (anchor: string) => (Astro.url.pathname === '/' ? anchor : `/${anchor}`);
const links = [
	{ href: homeHref('#producto'), label: 'Home' },
	{ href: homeHref('#features'), label: 'Features' },
	{ href: '/revision', label: 'Analizador Repositorio' },
	{ href: '/librerias', label: 'Librerías' },
	{ href: '/servicios', label: 'API Tester' },
	{ href: '/benchmarks', label: 'Benchmarks' },
	{ href: '/code-lab', label: 'CodeLab' },
	{ href: '/equipo', label: 'Equipo' },
	{ href: '/revision', label: 'Analizador Repositorio', toolLink: true },
	{ href: '/librerias', label: 'Librerías', toolLink: true },
	{ href: '/servicios', label: 'API Tester', toolLink: true },
	{ href: '/benchmarks', label: 'Benchmarks', toolLink: true },
	{ href: '/code-lab', label: 'CodeLab', toolLink: true },
];
---

<header class="site-header">
	<nav class="site-nav" aria-label="Navegacion principal">
		<div class="logo">
			<Logo width={40} height={24} pairs={4} class="logo-helix" />
			StackDNA
		</div>
		<div class="nav-links">
			{links.map((link) => <a href={link.href} class={link.toolLink ? 'tool-link' : ''}>{link.label}</a>)}
		</div>
	</nav>
</header>
