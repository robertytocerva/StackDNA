---
import Logo from './Logo.astro';

const homeHref = (anchor: string) => (Astro.url.pathname === '/' ? anchor : `/${anchor}`);
const links = [
	{ href: homeHref('#producto'), label: 'Producto' },
	{ href: homeHref('#about'), label: 'Acerca de' },
	{ href: homeHref('#features'), label: 'Features' },
	{ href: '/revision', label: 'Analizador Repositorio' },
	{ href: '/librerias', label: 'Librerías' },
	{ href: '/servicios', label: 'API Tester' },
	{ href: '/benchmarks', label: 'Benchmarks' },
	{ href: '/codelab', label: 'CodeLab' },
	{ href: '/equipo', label: 'Equipo' },
];
---

<header class="site-header">
	<nav class="site-nav" aria-label="Navegacion principal">
		<div class="logo">
			<Logo width={46} height={24} pairs={4} class="logo-helix" />
			StackDNA
		</div>
		<div class="nav-links">
			{links.map((link) => <a href={link.href}>{link.label}</a>)}
		</div>
	</nav>
</header>
