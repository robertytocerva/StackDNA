<div class="helix-stage" data-reveal data-reveal-from="right" aria-hidden="true">
	<div class="helix" id="helix" data-helix></div>
</div>

<script>
	const LAYERS = ['AWS', 'Java', 'MySQL', 'Python', 'JavaScript', 'React', 'Docker', 'Infrastructure', 'Frontend', 'Backend', 'Database', 'DevOps'];
	const COUNT = 12;
	const TOTAL_HEIGHT = 480;

	function buildHelix(helix: HTMLElement) {
		// El DOM entrante de una view transition llega vacío: se reconstruye desde cero.
		helix.replaceChildren();

		for (let i = 0; i < COUNT; i++) {
			const rung = document.createElement('div');
			const y = (i / (COUNT - 1)) * TOTAL_HEIGHT - TOTAL_HEIGHT / 2;
			const rotY = (i / COUNT) * 360;

			rung.className = 'rung';
			rung.style.setProperty('--rung-y', `${y}px`);
			rung.style.setProperty('--rung-rot', `${rotY}deg`);
			rung.innerHTML = `
				<div class="bar"></div>
				<span class="node a"></span>
				<span class="node b"></span>
				<span class="label">${LAYERS[i % LAYERS.length]}</span>
			`;

			helix.appendChild(rung);
		}
	}

	function initHelix() {
		document.querySelectorAll<HTMLElement>('[data-helix]').forEach((helix) => {
			if (helix.dataset.helixBuilt === 'true') return;
			helix.dataset.helixBuilt = 'true';
			buildHelix(helix);
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initHelix);
	} else {
		initHelix();
	}

	// El script de un componente no se reejecuta tras una navegación con
	// ClientRouter, así que hay que poblar de nuevo el helix del DOM entrante.
	document.addEventListener('astro:page-load', initHelix);
</script>
