---
import type { LibraryCategory } from '../../data/libraries';

interface LanguageOption {
	value: string;
	label: string;
	icon: string;
}

interface Props {
	languages: LanguageOption[];
	categories: LibraryCategory[];
	selectedLanguage?: string;
	selectedCategory?: LibraryCategory | 'all';
}

const {
	languages,
	categories,
	selectedLanguage = 'all',
	selectedCategory = 'all',
} = Astro.props;

const categoryLabels: Record<LibraryCategory, string> = {
	utilities: 'Utilities',
	data: 'Data',
	networking: 'Networking',
	datetime: 'Date & time',
	math: 'Math',
	system: 'System',
};
---

<div class="filter-bar" data-filter-component>
	<div class="filter-row">
		<div class="filter-heading">
			<span class="filter-index">01</span>
			<span>Lenguaje</span>
		</div>
		<div class="filter-options" role="group" aria-label="Filtrar por lenguaje">
			<button
				class:list={['filter-chip', { active: selectedLanguage === 'all' }]}
				type="button"
				aria-pressed={selectedLanguage === 'all'}
				data-filter-language="all"
			>
				<span>Todos</span>
			</button>
			{languages.map((language) => (
				<button
					class:list={['filter-chip', { active: selectedLanguage === language.value }]}
					type="button"
					aria-pressed={selectedLanguage === language.value}
					data-filter-language={language.value}
				>
					<img class="chip-icon" src={language.icon} alt="" loading="lazy" aria-hidden="true" />
					<span>{language.label}</span>
				</button>
			))}
		</div>
	</div>

	<div class="filter-row">
		<div class="filter-heading">
			<span class="filter-index">02</span>
			<span>Categoría</span>
		</div>
		<div class="filter-options" role="group" aria-label="Filtrar por categoría">
			<button
				class:list={['filter-chip', { active: selectedCategory === 'all' }]}
				type="button"
				aria-pressed={selectedCategory === 'all'}
				data-filter-category="all"
			>
				<span>Todas</span>
			</button>
			{categories.map((category) => (
				<button
					class:list={['filter-chip', { active: selectedCategory === category }]}
					type="button"
					aria-pressed={selectedCategory === category}
					data-filter-category={category}
				>
					<span>{categoryLabels[category]}</span>
				</button>
			))}
		</div>
	</div>
</div>

<style>
	.filter-bar {
		display: grid;
		gap: 1px;
		margin-top: 28px;
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
	}

	.filter-row {
		display: flex;
		align-items: center;
		gap: 22px;
		min-width: 0;
		padding: 17px 0;
	}

	.filter-row + .filter-row {
		border-top: 1px solid rgba(139, 92, 246, 0.09);
	}

	.filter-heading {
		display: flex;
		width: 105px;
		align-items: center;
		gap: 9px;
		flex: 0 0 auto;
		color: var(--text-dim);
		font-size: 12px;
		font-weight: 600;
	}

	.filter-index {
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 400;
	}

	.filter-options {
		display: flex;
		min-width: 0;
		align-items: center;
		gap: 8px;
		overflow-x: auto;
		padding: 3px 2px;
		scrollbar-width: none;
	}

	.filter-options::-webkit-scrollbar {
		display: none;
	}

	.filter-chip {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		min-height: 32px;
		padding: 6px 11px;
		border: 1px solid var(--border);
		border-radius: 100px;
		background: rgba(21, 21, 31, 0.58);
		color: var(--text-dim);
		font-family: var(--font-body);
		font-size: 12px;
		font-weight: 500;
		white-space: nowrap;
		cursor: pointer;
		transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
	}

	.filter-chip:hover {
		border-color: var(--border-strong);
		color: var(--text);
		transform: translateY(-1px);
	}

	.filter-chip.active {
		border-color: var(--purple-2);
		background: rgba(124, 58, 237, 0.18);
		box-shadow: inset 0 0 0 1px rgba(167, 139, 250, 0.08), 0 0 16px rgba(124, 58, 237, 0.1);
		color: var(--white);
	}

	.chip-icon {
		width: 15px;
		height: 15px;
		object-fit: contain;
	}

	@media (max-width: 600px) {
		.filter-row {
			display: block;
			padding: 14px 0;
		}

		.filter-heading {
			width: auto;
			margin-bottom: 9px;
		}

		.filter-options {
			margin-left: 18px;
		}
	}
</style>
