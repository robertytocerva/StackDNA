---
import type { HttpMethod, ServiceDefinition } from '../../data/services';

interface Props {
	services: ServiceDefinition[];
}

const { services } = Astro.props;
const methods: Array<HttpMethod | 'ALL'> = ['ALL', 'GET', 'POST', 'PUT', 'DELETE'];
const methodLabels: Record<HttpMethod | 'ALL', string> = {
	ALL: 'ALL',
	GET: 'GET',
	POST: 'POST',
	PUT: 'PUT',
	DELETE: 'DELETE',
};
const serviceNames = [...new Set(services.map((service) => service.name))].sort();
---

<section class="api-controls" data-api-filters aria-label="Filtros del API Tester">
	<div class="api-filter-group">
		<div class="api-filter-heading">
			<span class="api-filter-index">01</span>
			<span>Método</span>
		</div>
		<div class="api-filter-options" role="group" aria-label="Filtrar por método HTTP">
			{methods.map((method) => (
				<button
					class:list={['api-filter-chip', { active: method === 'ALL' }]}
					type="button"
					aria-pressed={method === 'ALL'}
					data-method-filter={method}
				>
					<span class:list={['api-method-dot', `api-method-${method.toLowerCase()}`]} aria-hidden="true"></span>
					<span>{methodLabels[method]}</span>
				</button>
			))}
		</div>
	</div>

	<div class="api-filter-group api-service-group">
		<div class="api-filter-heading">
			<span class="api-filter-index">02</span>
			<span>Servicio</span>
		</div>
		<label class="api-service-select-wrap" for="api-service-filter">
			<span class="sr-only">Filtrar por servicio</span>
			<select id="api-service-filter" class="api-service-select" data-service-filter>
				<option value="ALL">TODOS LOS SERVICIOS</option>
				{serviceNames.map((name) => <option value={name}>{name}</option>)}
			</select>
			<span class="api-select-arrow" aria-hidden="true">⌄</span>
		</label>
	</div>

	<div class="api-controls-footer">
		<span class="api-filter-status" data-filter-status aria-live="polite">
			{services.length} servicios disponibles
		</span>
		<button class="api-add-service" type="button" data-add-service>
			<span aria-hidden="true">＋</span> Añadir servicio
		</button>
	</div>
</section>

<style>
	.api-controls {
		display: grid;
		gap: 1px;
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
		background: rgba(139, 92, 246, 0.02);
	}

	.api-filter-group {
		display: flex;
		align-items: center;
		gap: 22px;
		min-width: 0;
		padding: 17px 0;
	}

	.api-filter-group + .api-filter-group {
		border-top: 1px solid rgba(139, 92, 246, 0.09);
	}

	.api-filter-heading {
		display: flex;
		width: 105px;
		align-items: center;
		gap: 9px;
		flex: 0 0 auto;
		color: var(--text-dim);
		font-size: 12px;
		font-weight: 600;
	}

	.api-filter-index {
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 400;
	}

	.api-filter-options {
		display: flex;
		min-width: 0;
		align-items: center;
		gap: 8px;
		overflow-x: auto;
		padding: 3px 2px;
		scrollbar-width: none;
	}

	.api-filter-options::-webkit-scrollbar {
		display: none;
	}

	.api-filter-chip {
		display: inline-flex;
		min-height: 34px;
		align-items: center;
		gap: 7px;
		padding: 6px 12px;
		border: 1px solid var(--border);
		border-radius: 100px;
		background: rgba(21, 21, 31, 0.58);
		color: var(--text-dim);
		font-family: var(--font-mono);
		font-size: 11px;
		white-space: nowrap;
		cursor: pointer;
		transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
	}

	.api-filter-chip:hover {
		border-color: var(--border-strong);
		color: var(--text);
		transform: translateY(-1px);
	}

	.api-filter-chip.active {
		border-color: var(--purple-2);
		background: rgba(124, 58, 237, 0.18);
		box-shadow: inset 0 0 0 1px rgba(167, 139, 250, 0.08), 0 0 16px rgba(124, 58, 237, 0.1);
		color: var(--white);
	}

	.api-method-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--text-faint);
	}

	.api-method-get { background: #7ee787; }
	.api-method-post { background: var(--purple-glow); }
	.api-method-put { background: #ffab70; }
	.api-method-delete { background: #ff7b72; }

	.api-service-group {
		padding-bottom: 17px;
	}

	.api-service-select-wrap {
		position: relative;
		display: block;
		min-width: 240px;
	}

	.api-service-select {
		width: 100%;
		min-height: 36px;
		padding: 6px 34px 6px 12px;
		appearance: none;
		border: 1px solid var(--border);
		border-radius: 6px;
		outline: 0;
		background: var(--surface);
		color: var(--text-dim);
		font-family: var(--font-mono);
		font-size: 10px;
		cursor: pointer;
		transition: border-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
	}

	.api-service-select:hover,
	.api-service-select:focus {
		border-color: var(--purple-glow);
		box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.1);
		color: var(--white);
	}

	.api-select-arrow {
		position: absolute;
		top: 50%;
		right: 12px;
		color: var(--purple-soft);
		font-family: var(--font-mono);
		font-size: 15px;
		pointer-events: none;
		transform: translateY(-55%);
	}

	.api-controls-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 18px;
		padding: 16px 0;
		border-top: 1px solid rgba(139, 92, 246, 0.09);
	}

	.api-filter-status {
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 10px;
	}

	.api-add-service {
		display: inline-flex;
		min-height: 38px;
		align-items: center;
		gap: 5px;
		padding: 8px 15px;
		border: 1px solid var(--purple-2);
		border-radius: 6px;
		background: var(--purple);
		color: var(--white);
		font-family: var(--font-mono);
		font-size: 11px;
		cursor: pointer;
		transition: background 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
	}

	.api-add-service:hover {
		background: var(--purple-2);
		box-shadow: 0 0 22px rgba(124, 58, 237, 0.4);
		transform: translateY(-1px);
	}

	.api-add-service span {
		font-size: 17px;
		line-height: 0;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 600px) {
		.api-filter-group {
			display: block;
			padding: 14px 0;
		}

		.api-filter-heading {
			width: auto;
			margin-bottom: 9px;
		}

		.api-filter-options {
			margin-left: 18px;
		}

		.api-service-select-wrap {
			margin-left: 18px;
		}
	}

	@media (max-width: 430px) {
		.api-controls-footer {
			align-items: flex-start;
			flex-direction: column;
		}

		.api-add-service {
			width: 100%;
			justify-content: center;
		}
	}
</style>
