---
import ApiCard from './ApiCard.astro';
import type { AWSService } from '../../data/services';

interface Props {
	services: AWSService[];
}

const { services } = Astro.props;
---

<section class="api-grid-section" aria-labelledby="api-grid-title">
	<div class="api-grid-heading">
		<div>
			<span class="api-grid-tag">CATÁLOGO DE SERVICIOS AWS</span>
			<h2 id="api-grid-title">Secuencia de servicios</h2>
		</div>
		<span class="api-visible-count" data-visible-count aria-live="polite">{services.length} servicios visibles</span>
	</div>

	<div class="api-grid" data-api-grid>
		{services.map((service) => <ApiCard service={service} />)}
		<div class="api-empty-state" data-empty-state hidden>
			<span class="api-empty-icon" aria-hidden="true">⌕</span>
			<div>
				<span class="api-empty-kicker">NO_MATCH / 404</span>
				<p>No se encontraron servicios para este filtro.</p>
			</div>
		</div>
	</div>
</section>

<style>
	.api-grid-section { padding-top: 48px; }
	.api-grid-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 22px; }
	.api-grid-tag { display: block; margin-bottom: 10px; color: var(--purple-soft); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; }
	.api-grid-heading h2 { margin: 0; font-size: clamp(25px, 3vw, 35px); }
	.api-visible-count { padding-bottom: 5px; color: var(--text-faint); font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; }
	.api-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: start; gap: 18px; }
	.api-empty-state { display: flex; grid-column: 1 / -1; align-items: center; gap: 15px; min-height: 126px; padding: 24px; border: 1px dashed var(--border-strong); border-radius: 9px; background: rgba(8, 8, 12, 0.24); }
	.api-empty-icon { display: grid; width: 42px; height: 42px; flex: 0 0 auto; place-items: center; border: 1px solid var(--border-strong); border-radius: 50%; color: var(--purple-2); font-size: 24px; }
	.api-empty-kicker { color: var(--purple-soft); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; }
	.api-empty-state p { margin-top: 3px; color: var(--text); font-size: 13px; }
	@media (max-width: 1100px) { .api-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (max-width: 700px) { .api-grid { grid-template-columns: 1fr; } }
	@media (max-width: 560px) { .api-grid-heading { align-items: flex-start; flex-direction: column; gap: 9px; } .api-grid-section { padding-top: 38px; } }
</style>
