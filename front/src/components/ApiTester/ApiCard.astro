---
import { getDefaultRequestJson, type ServiceDefinition } from '../../data/services';

interface Props {
	service: ServiceDefinition;
	template?: boolean;
}

const { service, template = false } = Astro.props;
const editorId = `editor-${service.id}`;
const responseId = `res-${service.id}`;
---

<article
	class="api-card"
	id={`card-${service.id}`}
	data-api-card
	data-service-id={service.id}
	data-service-name={service.name}
	data-method={service.method}
	data-template-card={template ? 'true' : undefined}
>
	<header class="api-card-header">
		<div class="api-card-identity">
			<span class="api-card-index" aria-hidden="true">//</span>
			<div>
				<div class="api-card-title-row">
					<h3 data-service-name-label>{service.name}</h3>
					<span class="api-method-badge" data-method-badge>{service.method}</span>
				</div>
				<span class="api-card-kicker">AWS SERVICE / REQUEST NODE</span>
			</div>
		</div>
		<button class="api-delete-button" type="button" data-delete-service aria-label={`Eliminar servicio ${service.name}`}>
			<span aria-hidden="true">×</span>
		</button>
	</header>

	<div class="api-card-body">
		<div class="api-url-box" title="URL no modificable">
			<span class="api-url-label">ENDPOINT</span>
			<code data-service-url>{service.url}</code>
		</div>

		<div class="api-editor-container">
			<div class="api-field-heading">
				<label for={editorId}>Request payload</label>
				<span>JSON / editable</span>
			</div>
			<textarea
				id={editorId}
				data-service-editor
				spellcheck="false"
				aria-label={`Payload JSON para ${service.name}`}
				>{getDefaultRequestJson(service)}</textarea
			>
			<button class="api-reset-button" type="button" data-reset-editor>RESET</button>
		</div>

		<div class="api-action-row">
			<button class="api-send-button" type="button" data-send-request>
				<span aria-hidden="true">▶</span> EJECUTAR PETICIÓN
			</button>
		</div>

		<pre
			class="api-response-box"
			id={responseId}
			data-response-box
			aria-live="polite"
			aria-label={`Respuesta de ${service.name}`}
		>/* La respuesta simulada aparecerá aquí... */</pre
		>
	</div>
</article>

<style>
	.api-card {
		position: relative;
		display: flex;
		min-width: 0;
		flex-direction: column;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: linear-gradient(160deg, rgba(27, 27, 40, 0.76), rgba(15, 15, 22, 0.94));
		box-shadow: 0 16px 42px rgba(0, 0, 0, 0.16), inset 0 1px rgba(255, 255, 255, 0.025);
		transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
	}

	.api-card::before {
		position: absolute;
		top: 0;
		left: 0;
		width: 76px;
		height: 2px;
		background: linear-gradient(90deg, var(--purple-glow), transparent);
		content: '';
	}

	.api-card:hover {
		border-color: var(--border-strong);
		box-shadow: 0 20px 48px rgba(0, 0, 0, 0.23), 0 0 30px rgba(124, 58, 237, 0.06);
		transform: translateY(-3px);
	}

	.api-card[hidden] {
		display: none;
	}

	.api-card-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 18px;
		padding: 19px 20px 16px;
		border-bottom: 1px solid var(--border);
		background: rgba(124, 58, 237, 0.035);
	}

	.api-card-identity {
		display: flex;
		min-width: 0;
		gap: 11px;
	}

	.api-card-index {
		padding-top: 3px;
		color: var(--purple-2);
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 600;
	}

	.api-card-title-row {
		display: flex;
		align-items: center;
		gap: 9px;
		flex-wrap: wrap;
	}

	.api-card-title-row h3 {
		color: var(--white);
		font-family: var(--font-display);
		font-size: 18px;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.api-method-badge {
		padding: 3px 7px;
		border: 1px solid rgba(167, 139, 250, 0.22);
		border-radius: 4px;
		background: rgba(124, 58, 237, 0.13);
		color: var(--purple-soft);
		font-family: var(--font-mono);
		font-size: 9px;
		font-weight: 500;
	}

	.api-card-kicker {
		display: block;
		margin-top: 4px;
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 9px;
		letter-spacing: 0.08em;
	}

	.api-delete-button {
		display: grid;
		width: 30px;
		height: 30px;
		flex: 0 0 auto;
		place-items: center;
		border: 1px solid transparent;
		border-radius: 6px;
		background: transparent;
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 20px;
		line-height: 1;
		cursor: pointer;
		transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
	}

	.api-delete-button:hover,
	.api-delete-button:focus-visible {
		border-color: rgba(255, 123, 114, 0.35);
		background: rgba(255, 123, 114, 0.08);
		color: #ff7b72;
	}

	.api-card-body {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 18px 20px 20px;
	}

	.api-url-box {
		display: flex;
		align-items: flex-start;
		gap: 11px;
		min-width: 0;
		padding: 10px;
		border: 1px solid var(--border);
		border-radius: 6px;
		background: rgba(8, 8, 12, 0.52);
	}

	.api-url-label {
		padding-top: 1px;
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 9px;
		letter-spacing: 0.08em;
	}

	.api-url-box code {
		min-width: 0;
		color: var(--purple-soft);
		font-family: var(--font-mono);
		font-size: 10px;
		line-height: 1.5;
		word-break: break-all;
		user-select: all;
	}

	.api-editor-container {
		position: relative;
	}

	.api-field-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-bottom: 7px;
	}

	.api-field-heading label {
		color: var(--text);
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.api-field-heading span {
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 9px;
	}

	.api-card textarea {
		width: 100%;
		min-height: 154px;
		padding: 13px;
		resize: vertical;
		border: 1px solid var(--border);
		border-radius: 7px;
		outline: 0;
		background: #0a0a0f;
		color: var(--text);
		font-family: var(--font-mono);
		font-size: 10px;
		line-height: 1.65;
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.api-card textarea:focus {
		border-color: var(--purple-glow);
		box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.1);
	}

	.api-reset-button {
		position: absolute;
		top: 29px;
		right: 9px;
		padding: 4px 7px;
		border: 1px solid rgba(167, 139, 250, 0.16);
		border-radius: 4px;
		background: rgba(21, 21, 31, 0.9);
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 8px;
		cursor: pointer;
		transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
	}

	.api-reset-button:hover,
	.api-reset-button:focus-visible {
		border-color: var(--purple-2);
		background: var(--purple);
		color: var(--white);
	}

	.api-action-row {
		display: flex;
		gap: 8px;
	}

	.api-send-button {
		display: inline-flex;
		width: 100%;
		min-height: 40px;
		align-items: center;
		justify-content: center;
		gap: 8px;
		padding: 8px 13px;
		border: 1px solid var(--purple-2);
		border-radius: 6px;
		background: transparent;
		color: var(--purple-soft);
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 600;
		cursor: pointer;
		transition: background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
	}

	.api-send-button:hover:not(:disabled),
	.api-send-button:focus-visible:not(:disabled) {
		background: var(--purple);
		box-shadow: 0 0 20px rgba(124, 58, 237, 0.32);
		color: var(--white);
		transform: translateY(-1px);
	}

	.api-send-button:disabled {
		cursor: wait;
		opacity: 0.65;
	}

	.api-response-box {
		min-height: 92px;
		max-height: 230px;
		overflow: auto;
		margin: 0;
		padding: 13px;
		border: 1px solid var(--border);
		border-radius: 7px;
		background: #09090d;
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 10px;
		line-height: 1.6;
		white-space: pre-wrap;
		word-break: break-word;
		transition: border-color 0.2s ease, color 0.2s ease;
	}

	.api-response-box.success {
		border-left: 3px solid #7ee787;
		color: #9be9a5;
	}

	.api-response-box.error {
		border-left: 3px solid #ff7b72;
		color: #ffaaa5;
	}

	.api-response-box.loading {
		border-left: 3px solid var(--purple-2);
		color: var(--purple-soft);
	}

	@media (max-width: 560px) {
		.api-card-header {
			padding-inline: 16px;
		}

		.api-card-body {
			padding-inline: 16px;
		}

		.api-card-title-row h3 {
			font-size: 16px;
		}

		.api-field-heading span {
			display: none;
		}
	}
</style>
