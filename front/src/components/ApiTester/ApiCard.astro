---
import type { AWSService } from '../../data/services';

interface Props {
	service: AWSService;
}

const { service } = Astro.props;
const editorId = `payload-${service.id}`;
---

<article class={`api-card method-${service.method.toLowerCase()}`} data-service-id={service.id} data-method={service.method}>
	<header class="api-card-header">
		<div class="api-card-identity">
			<span class="api-card-index" aria-hidden="true">//</span>
			<div>
				<div class="api-card-title-row">
					<h3 class="service-name">{service.name}</h3>
					<span class="api-method-badge">{service.method}</span>
				</div>
				<span class="api-card-kicker">AWS SERVICE / REQUEST NODE</span>
			</div>
		</div>
	</header>

	<div class="api-card-body">
		<div class="api-description">
			<p>{service.description}</p>
			<span>Action: <strong>{service.action}</strong></span>
		</div>

		<div class="api-url-box" title="Endpoint oficial de AWS">
			<span class="api-url-label">ENDPOINT</span>
			<code>{service.endpoint}</code>
		</div>

		<div class="api-editor-container">
			<div class="api-field-heading">
				<label for={editorId}>Request payload</label>
				<span>JSON / editable</span>
			</div>
			<textarea id={editorId} class="payload-editor" spellcheck="false" aria-label={`Payload JSON para ${service.name}`}>{JSON.stringify(service.payloadExample, null, 2)}</textarea>
		</div>

		<button class="btn-ejecutar api-send-button" type="button">
			<span aria-hidden="true">▶</span> EJECUTAR PETICIÓN
		</button>

		<pre class="response-box api-response-box" aria-live="polite" aria-label={`Respuesta de ${service.name}`}>La respuesta aparecerá aquí...</pre>

		<a class="api-docs-link" href={service.docsUrl} target="_blank" rel="noopener noreferrer">
			<span aria-hidden="true">↗</span> Ver documentación oficial
		</a>
	</div>
</article>

<style>
	.api-card {
		--method-color: var(--purple-glow);
		--method-soft: rgba(167, 139, 250, 0.16);
		--method-border: rgba(167, 139, 250, 0.35);
		display: flex;
		min-width: 0;
		flex-direction: column;
		overflow: hidden;
		border: 1px solid var(--method-border);
		border-radius: 12px;
		background:
			linear-gradient(180deg, var(--method-soft), transparent 34%),
			linear-gradient(160deg, rgba(27, 27, 40, 0.78), rgba(15, 15, 22, 0.96));
		box-shadow: 0 16px 42px rgba(0, 0, 0, 0.16), 0 0 0 1px rgba(255, 255, 255, 0.018), inset 0 1px rgba(255, 255, 255, 0.025);
		transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
	}

	.api-card.method-get {
		--method-color: #67e8f9;
		--method-soft: rgba(34, 211, 238, 0.1);
		--method-border: rgba(103, 232, 249, 0.42);
	}

	.api-card.method-post {
		--method-color: #fbbf24;
		--method-soft: rgba(251, 191, 36, 0.1);
		--method-border: rgba(251, 191, 36, 0.42);
	}

	.api-card:hover {
		border-color: var(--method-color);
		transform: translateY(-3px);
		box-shadow: 0 20px 48px rgba(0, 0, 0, 0.23), 0 0 28px var(--method-soft);
	}

	.api-card[hidden] { display: none; }
	.api-card-header {
		padding: 19px 20px 16px;
		border-bottom: 1px solid var(--method-border);
		background: linear-gradient(90deg, var(--method-soft), rgba(124, 58, 237, 0.03));
	}
	.api-card-identity { display: flex; min-width: 0; gap: 11px; }
	.api-card-index { padding-top: 3px; color: var(--method-color); font-family: var(--font-mono); font-size: 12px; font-weight: 600; }
	.api-card-title-row { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }
	.api-card-title-row h3 { color: var(--white); font-family: var(--font-display); font-size: 18px; font-weight: 600; letter-spacing: -0.02em; }
	.api-method-badge {
		padding: 4px 8px;
		border: 1px solid var(--method-border);
		border-radius: 5px;
		background: var(--method-soft);
		color: var(--method-color);
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.06em;
	}
	.api-card-kicker { display: block; margin-top: 4px; color: var(--text-faint); font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.08em; }
	.api-card-body { display: flex; flex-direction: column; gap: 16px; padding: 18px 20px 20px; }
	.api-description p { color: var(--text-dim); font-size: 12px; line-height: 1.55; }
	.api-description span { display: block; margin-top: 7px; color: var(--text-faint); font-family: var(--font-mono); font-size: 9px; }
	.api-description strong { color: var(--method-color); font-weight: 600; }
	.api-url-box {
		display: grid;
		gap: 8px;
		min-width: 0;
		padding: 12px;
		border: 1px solid var(--method-border);
		border-radius: 8px;
		background: rgba(8, 8, 12, 0.62);
	}
	.api-url-label {
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.12em;
	}
	.api-url-box code {
		min-width: 0;
		color: var(--white);
		font-family: var(--font-mono);
		font-size: 11.5px;
		font-weight: 500;
		line-height: 1.55;
		word-break: break-all;
	}
	.api-field-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 7px; }
	.api-field-heading label {
		color: var(--white);
		font-family: var(--font-display);
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0;
		text-transform: none;
	}
	.api-field-heading span { color: var(--text-faint); font-family: var(--font-mono); font-size: 10px; }
	.payload-editor {
		width: 100%;
		min-height: 164px;
		padding: 14px;
		resize: vertical;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-left: 3px solid var(--method-color);
		border-radius: 8px;
		outline: 0;
		background: #09090d;
		color: #ece7ff;
		font-family: var(--font-mono);
		font-size: 11.5px;
		font-weight: 500;
		line-height: 1.7;
		tab-size: 2;
	}
	.payload-editor:focus { border-color: var(--method-border); border-left-color: var(--method-color); box-shadow: 0 0 0 3px var(--method-soft); }
	.api-send-button { display: inline-flex; width: 100%; min-height: 40px; align-items: center; justify-content: center; gap: 8px; padding: 8px 13px; border: 1px solid var(--purple-2); border-radius: 6px; background: transparent; color: var(--purple-soft); font-family: var(--font-mono); font-size: 10px; font-weight: 600; cursor: pointer; transition: background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease; }
	.api-send-button:hover:not(:disabled), .api-send-button:focus-visible:not(:disabled) { background: var(--purple); box-shadow: 0 0 20px rgba(124, 58, 237, 0.32); color: var(--white); transform: translateY(-1px); }
	.api-send-button:disabled { cursor: wait; opacity: 0.65; }
	.response-box {
		min-height: 104px;
		max-height: 250px;
		overflow: auto;
		margin: 0;
		padding: 14px;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-left: 3px solid var(--method-color);
		border-radius: 8px;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.018), transparent), #08080c;
		color: #a9a3bb;
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		line-height: 1.7;
		white-space: pre-wrap;
		word-break: break-word;
	}
	.response-box.success { border-left: 3px solid #7ee787; color: #9be9a5; }
	.response-box.error { border-left: 3px solid #ff7b72; color: #ffaaa5; }
	.response-box.loading { border-left: 3px solid var(--purple-2); color: var(--purple-soft); }
	.api-docs-link { color: var(--purple-soft); font-family: var(--font-mono); font-size: 10px; text-decoration: none; }
	.api-docs-link:hover { color: var(--white); text-decoration: underline; }
	@media (max-width: 560px) { .api-card-header, .api-card-body { padding-inline: 16px; } .api-card-title-row h3 { font-size: 16px; } .api-field-heading span { display: none; } }
</style>
