---
import LibraryCard from '../LibraryCard/LibraryCard.astro';
import type { LibraryEntry } from '../../data/libraries';

interface Props {
	language: string;
	libraries: LibraryEntry[];
	languageIcon: string;
}

const { language, libraries, languageIcon } = Astro.props;
---

<section class="language-section" data-language-section={language} aria-labelledby={`language-${language}`}>
	<header class="language-section-header">
		<div class="language-title-wrap">
			<span class="language-index" aria-hidden="true">//</span>
			<span class="language-icon" aria-hidden="true">{languageIcon}</span>
			<div>
				<h2 id={`language-${language}`}>{language}</h2>
				<p>Biblioteca de {language}</p>
			</div>
		</div>
		<span class="language-count"><strong>{String(libraries.length).padStart(2, '0')}</strong> librerías</span>
	</header>
	<div class="library-grid">
		{libraries.map((libraryData) => <LibraryCard libraryData={libraryData} />)}
	</div>
</section>

<style>
	.language-section {
		padding-top: 54px;
	}

	.language-section + .language-section {
		margin-top: 57px;
		border-top: 1px solid var(--border);
	}

	.language-section-header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: 20px;
	}

	.language-title-wrap {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.language-index {
		color: var(--purple-2);
		font-family: var(--font-mono);
		font-size: 14px;
		font-weight: 600;
	}

	.language-icon {
		display: grid;
		width: 40px;
		height: 40px;
		place-items: center;
		border: 1px solid var(--border-strong);
		border-radius: 9px;
		background: rgba(124, 58, 237, 0.08);
		font-size: 21px;
	}

	.language-title-wrap h2 {
		margin: 0;
		color: var(--white);
		font-family: var(--font-display);
		font-size: 25px;
		font-weight: 600;
	}

	.language-title-wrap p {
		margin-top: 2px;
		color: var(--text-faint);
		font-size: 11px;
	}

	.language-count {
		padding-bottom: 5px;
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 10px;
		text-transform: uppercase;
	}

	.language-count strong {
		margin-right: 5px;
		color: var(--purple-soft);
		font-size: 13px;
		font-weight: 500;
	}

	.library-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 18px;
	}

	@media (max-width: 960px) {
		.library-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 560px) {
		.language-section-header {
			align-items: flex-start;
			flex-direction: column;
			gap: 10px;
		}
	}
</style>
