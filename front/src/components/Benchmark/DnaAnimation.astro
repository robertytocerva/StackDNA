---
interface Props {
	index: number;
}

const { index } = Astro.props;
---

<div class="card-dna">
	<svg class="dna-mini" viewBox="0 0 24 80" fill="none" aria-hidden="true">
		<path
			d="M6 4C6 16 18 16 18 28C18 40 6 40 6 52C6 64 18 64 18 76"
			stroke="url(#dnaGrad)"
			stroke-width="1.5"
			stroke-linecap="round"
		/>
		<defs>
			<linearGradient id="dnaGrad" x1="12" y1="0" x2="12" y2="80" gradientUnits="userSpaceOnUse">
				<stop stop-color="var(--purple-glow)" />
				<stop offset="1" stop-color="var(--purple)" />
			</linearGradient>
		</defs>
	</svg>
	<span class="card-seq">{String(index).padStart(3, '0')}</span>
</div>
