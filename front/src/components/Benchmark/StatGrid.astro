---

<section class="grid grid-cols-2 md:grid-cols-4 gap-4" style="margin-bottom: 3rem;" id="statsGrid">
  <div class="stat-card">
    <div class="text-[10px] mono uppercase tracking-widest mb-2" style="color:var(--fg-muted)">Modelos trackeados</div>
    <div class="text-3xl font-bold mono" id="statTotal">—</div>
  </div>
  <div class="stat-card">
    <div class="text-[10px] mono uppercase tracking-widest mb-2" style="color:var(--fg-muted)">Mayor Quality Index</div>
    <div class="text-3xl font-bold mono" id="statTopQuality" style="color:var(--accent-bright)">—</div>
    <div class="text-xs mt-1" style="color:var(--fg-dim)" id="statTopQualityName">—</div>
  </div>
  <div class="stat-card">
    <div class="text-[10px] mono uppercase tracking-widest mb-2" style="color:var(--fg-muted)">Más rápido (tok/s)</div>
    <div class="text-3xl font-bold mono" id="statTopSpeed">—</div>
    <div class="text-xs mt-1" style="color:var(--fg-dim)" id="statTopSpeedName">—</div>
  </div>
  <div class="stat-card">
    <div class="text-[10px] mono uppercase tracking-widest mb-2" style="color:var(--fg-muted)">Más barato (out $/M)</div>
    <div class="text-3xl font-bold mono" id="statCheapest" style="color:var(--success)">—</div>
    <div class="text-xs mt-1" style="color:var(--fg-dim)" id="statCheapestName">—</div>
  </div>
</section>
