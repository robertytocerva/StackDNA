---
---

<section class="mb-6">
  <div class="flex gap-3 items-center mb-4 flex-wrap">
    <div class="relative flex-1 min-w-[220px]">
      <svg style="position:absolute;left:12px;top:50%;transform:translateY(-50%);width:16px;height:16px;color:var(--fg-muted)" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      <input type="text" id="searchInput" class="search-input" placeholder="Buscar modelo o proveedor (GPT, Claude, Llama, DeepSeek…)">
    </div>
    <select id="sortSelect" class="search-input" style="padding-left:14px;width:auto;min-width:160px;cursor:pointer">
      <option value="quality">Ordenar: Quality ↓</option>
      <option value="speed">Ordenar: Speed ↓</option>
      <option value="context">Ordenar: Contexto ↓</option>
      <option value="price_out">Ordenar: Precio out ↑</option>
      <option value="release">Ordenar: Reciente ↓</option>
    </select>
  </div>
  <div class="flex gap-2 flex-wrap" id="providerFilters"></div>
</section>

<section id="stackContainer" class="reveal"></section>

<div id="emptyState" class="empty-state hidden">
  <div class="text-2xl mb-2">∅</div>
  <div>No se encontraron modelos con esos filtros.</div>
</div>
