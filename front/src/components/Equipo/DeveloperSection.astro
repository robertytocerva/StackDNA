---
import type { DeveloperEntry } from '../../data/team';

interface Props {
	developer: DeveloperEntry;
	index: number;
}

const { developer, index } = Astro.props;
const { name, role, bio, avatarUrl, profileUrl, githubUsername } = developer;
const position = String(index + 1).padStart(2, '0');
const hasPhoto = Boolean(avatarUrl);
---

<section class="dev-section" id={`dev-${developer.id}`} data-scroll-section data-developer-card data-github-username={githubUsername || undefined}>
	<div class="dev-media" aria-hidden="true" data-scroll-media>
		{hasPhoto ? (
			<img class="dev-photo" src={avatarUrl ?? undefined} alt="" loading="lazy" data-dev-photo />
		) : (
			<div class="dev-photo-placeholder" data-dev-photo-placeholder>
				<span>FOTO / GITHUB</span>
			</div>
		)}
		<div class="dev-overlay"></div>
	</div>

	<div class="wrap dev-content">
		<div class="dev-copy" data-scroll-item>
			<span class="dev-index" aria-hidden="true">{position} / 05</span>
			<span class="dev-name" data-dev-name>{name || 'Nombre pendiente'}</span>
			<span class="dev-role" data-dev-role>{role || 'Rol pendiente'}</span>
			<p class="dev-bio" data-dev-bio>{bio || 'Biografia pendiente de sincronizar desde GitHub.'}</p>
			<a class="dev-link" href={profileUrl ?? '#'} target="_blank" rel="noreferrer" data-dev-link hidden={!profileUrl}>
				Ver perfil de GitHub <span aria-hidden="true">↗</span>
			</a>
		</div>
	</div>
</section>

<style>
	.dev-section {
		position: relative;
		display: flex;
		min-height: 100vh;
		align-items: center;
		overflow: hidden;
		contain: layout style;
		background: var(--bg);
		border-top: 1px solid var(--border);
	}

	.dev-media {
		position: absolute;
		inset: -10%;
		z-index: 0;
		transform: translateZ(0);
		will-change: transform;
	}

	.dev-photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center center;
	}

	.dev-photo-placeholder {
		display: grid;
		width: 100%;
		height: 100%;
		place-items: center;
		background: radial-gradient(circle at 70% 40%, rgba(124, 58, 237, 0.16), var(--bg-elevated) 70%);
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.14em;
	}

	.dev-overlay {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse 120% 100% at 50% 50%, transparent 30%, var(--bg) 100%),
			linear-gradient(90deg, var(--bg) 0%, rgba(8, 8, 12, 0.75) 35%, rgba(8, 8, 12, 0.2) 65%, transparent 100%),
			linear-gradient(0deg, var(--bg) 0%, transparent 20%, transparent 80%, var(--bg) 100%);
	}

	.dev-content {
		position: relative;
		z-index: 1;
	}

	.dev-copy {
		max-width: 520px;
	}

	.dev-index {
		display: block;
		margin-bottom: 14px;
		color: var(--purple-soft);
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.12em;
	}

	.dev-name {
		display: block;
		margin-bottom: 10px;
		color: var(--white);
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.dev-role {
		display: block;
		margin-bottom: 22px;
		color: var(--purple-soft);
		font-family: var(--font-body);
		font-size: 15px;
		font-style: italic;
	}

	.dev-bio {
		color: var(--text-dim);
		font-size: 15.5px;
		line-height: 1.75;
	}

	.dev-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-top: 26px;
		padding: 11px 20px;
		border: 1px solid var(--purple-2);
		border-radius: 7px;
		background: transparent;
		color: var(--purple-soft);
		font-family: var(--font-mono);
		font-size: 13px;
		transition: background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
	}

	.dev-link:hover {
		background: var(--purple);
		box-shadow: 0 0 24px rgba(124, 58, 237, 0.4);
		color: var(--white);
		transform: translateY(-1px);
	}

	@media (max-width: 900px) {
		.dev-overlay {
			background: linear-gradient(180deg, rgba(8, 8, 12, 0.55) 0%, rgba(8, 8, 12, 0.88) 55%, var(--bg) 100%);
		}

		.dev-section {
			min-height: 84vh;
			align-items: flex-end;
			padding-bottom: 64px;
		}
	}

	@media (max-width: 560px) {
		.dev-section {
			min-height: 76vh;
			padding-bottom: 48px;
		}
	}
</style>
