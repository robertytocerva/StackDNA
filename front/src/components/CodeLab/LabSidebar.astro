---
/**
 * LabSidebar - Sidebar listing code examples grouped by library.
 * Renders language tabs and collapsible library groups with snippet buttons.
 * Icons use SVGs instead of emojis.
 */
import { LANGUAGES, EXAMPLES, type LanguageKey } from '../../data/codeExamples';

const languageKeys = Object.keys(LANGUAGES) as LanguageKey[];

/** SVG paths para los logos de lenguaje (inline, escalables) */
const LANG_SVGS: Record<LanguageKey, string> = {
	python: `<img src="/pylogo.svg" width="18" height="18" alt="Python" aria-hidden="true" />`,
	javascript: `<img src="/jslogo.svg" width="18" height="18" alt="JavaScript" aria-hidden="true" />`,
	java: `<img src="/javalogo.svg" width="18" height="18" alt="Java" aria-hidden="true" />`,
};

/** SVGs inline para cada librería/módulo */
const LIB_SVGS: Record<string, string> = {
	// Python built-ins
	math: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>`,
	os: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
	json: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="4 7 4 4 20 4 20 7"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="12" y1="4" x2="12" y2="20"/></svg>`,
	datetime: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
	random: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/><line x1="4" y1="4" x2="9" y2="9"/></svg>`,
	// JavaScript built-ins
	Array: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>`,
	Promise: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
	Object: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>`,
	String: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="4 7 4 4 20 4 20 7"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="12" y1="4" x2="12" y2="20"/></svg>`,
	'Math & Date': `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"/><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"/><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"/></svg>`,
	// Java built-ins
	ArrayList: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>`,
	HashMap: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>`,
	'Stream API': `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
	'String & Math': `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14.5 10c-.83 0-1.5-.67-1.5-1.5v-5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5v5c0 .83-.67 1.5-1.5 1.5z"/><path d="M20.5 10H19V8.5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/><path d="M9.5 14c.83 0 1.5.67 1.5 1.5v5c0 .83-.67 1.5-1.5 1.5S8 21.33 8 20.5v-5c0-.83.67-1.5 1.5-1.5z"/><path d="M3.5 14H5v1.5c0 .83-.67 1.5-1.5 1.5S2 16.33 2 15.5 2.67 14 3.5 14z"/><line x1="1" y1="1" x2="23" y2="23"/></svg>`,
};

/** Icono por defecto si no hay coincidencia */
const DEFAULT_LIB_SVG = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg>`;
---

<aside class="lab-sidebar" aria-label="Panel de ejemplos">
	<!-- Language Tabs -->
	<nav class="lang-tabs" role="tablist" aria-label="Seleccionar lenguaje">
		{languageKeys.map((key, idx) => (
			<button
				class:list={['lang-tab', { active: idx === 0 }]}
				role="tab"
				aria-selected={idx === 0 ? 'true' : 'false'}
				aria-controls="sidebar-examples"
				data-lang={key}
				id={`tab-${key}`}
			>
				<span class="lang-tab-icon" set:html={LANG_SVGS[key]} />
				<span class="lang-tab-name">{LANGUAGES[key].name}</span>
			</button>
		))}
	</nav>

	<!-- Examples List -->
	<div class="sidebar-examples" id="sidebar-examples" role="tabpanel" aria-labelledby="tab-python">
		{languageKeys.map((langKey, langIdx) => (
			<div
				class:list={['lang-group', { hidden: langIdx !== 0 }]}
				data-lang-group={langKey}
			>
				{EXAMPLES[langKey].map((lib) => (
					<div class="lib-section" data-lib={lib.name}>
						<div class="lib-header">
							<span class="lib-icon" set:html={LIB_SVGS[lib.name] ?? DEFAULT_LIB_SVG} />
							<span class="lib-name">{lib.name}</span>
							{lib.isBuiltIn && <span class="lib-badge">built-in</span>}
						</div>
						<div class="lib-snippets">
							{lib.snippets.map((snippet) => (
								<button
									class="snippet-btn"
									data-snippet-id={snippet.id}
									data-lang={langKey}
									aria-label={`Cargar ejemplo: ${snippet.title}`}
								>
									<span class="snippet-title">{snippet.title}</span>
									<span class="snippet-category">{snippet.category}</span>
								</button>
							))}
						</div>
					</div>
				))}
			</div>
		))}
	</div>
</aside>

<style>
	.lab-sidebar {
		display: flex;
		flex-direction: column;
		width: 260px;
		min-width: 260px;
		height: 100%;
		border-right: 1px solid var(--border);
		background: var(--bg-elevated);
		overflow: hidden;
	}

	.lang-tabs {
		display: flex;
		gap: 0;
		border-bottom: 1px solid var(--border);
		flex-shrink: 0;
	}

	.lang-tab {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		padding: 10px 6px;
		background: transparent;
		border: none;
		border-bottom: 2px solid transparent;
		color: var(--text-dim);
		font-family: var(--font-mono);
		font-size: 11px;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.lang-tab:hover {
		color: var(--white);
		background: rgba(124, 58, 237, 0.05);
	}

	.lang-tab.active {
		color: var(--purple-glow);
		border-bottom-color: var(--purple);
		background: rgba(124, 58, 237, 0.08);
	}

	.lang-tab-icon {
		display: flex;
		align-items: center;
		flex-shrink: 0;
		width: 18px;
		height: 18px;
	}

	.lang-tab-icon img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.lang-tab-name {
		display: none;
	}

	@media (min-width: 900px) {
		.lang-tab-name {
			display: inline;
		}
	}

	.sidebar-examples {
		flex: 1;
		overflow-y: auto;
		padding: 12px 0;
	}

	.sidebar-examples::-webkit-scrollbar {
		width: 4px;
	}

	.sidebar-examples::-webkit-scrollbar-track {
		background: transparent;
	}

	.sidebar-examples::-webkit-scrollbar-thumb {
		background: var(--border-strong);
		border-radius: 2px;
	}

	.lang-group {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.lang-group.hidden {
		display: none;
	}

	.lib-section {
		padding: 0 12px;
		margin-bottom: 8px;
	}

	.lib-header {
		display: flex;
		align-items: center;
		gap: 7px;
		padding: 6px 8px;
		margin-bottom: 2px;
		border-radius: 5px;
		color: var(--text);
		font-family: var(--font-display);
		font-size: 12px;
		font-weight: 600;
	}

	.lib-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 14px;
		height: 14px;
		color: var(--purple-glow);
		opacity: 0.85;
	}

	.lib-name {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.lib-badge {
		padding: 1px 6px;
		border-radius: 3px;
		background: rgba(124, 58, 237, 0.15);
		color: var(--purple-glow);
		font-family: var(--font-mono);
		font-size: 9px;
		font-weight: 500;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		flex-shrink: 0;
	}

	.lib-snippets {
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding-left: 8px;
	}

	.snippet-btn {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		width: 100%;
		padding: 7px 10px;
		border: none;
		border-radius: 5px;
		background: transparent;
		color: var(--text-dim);
		font-family: var(--font-body);
		font-size: 12px;
		text-align: left;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.snippet-btn:hover {
		background: rgba(124, 58, 237, 0.1);
		color: var(--white);
	}

	.snippet-btn.active {
		background: rgba(124, 58, 237, 0.16);
		color: var(--purple-soft);
	}

	.snippet-title {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.snippet-category {
		padding: 1px 5px;
		border-radius: 3px;
		background: rgba(255, 255, 255, 0.04);
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: 9px;
		flex-shrink: 0;
	}
</style>
