<Layout title="StackDNA - Secuencia el ADN de tu stack" description="StackDNA escanea repositorios para mapear dependencias, arquitectura, vulnerabilidades y licencias en un reporte accionable.">
	<div class="bg-noise" aria-hidden="true"></div>
	<Header />
	<main>
		<Hero />
		<About />
		<Features />
		<Team />
		<Pricing />
		<FAQ />
		<FinalCTA />
	</main>
	<Footer />
</Layout>
