---
const gradientId = `logo-gradient-${Astro.props.id ?? 'mark'}`;
---

<div class="logo">
	<span class="logo-mark" aria-hidden="true">
		<svg viewBox="0 0 24 24" fill="none">
			<path d="M6 2C6 6 18 6 18 10C18 14 6 14 6 18C6 22 18 22 18 22" stroke={`url(#${gradientId})`} stroke-width="2" stroke-linecap="round"></path>
			<defs>
				<linearGradient id={gradientId} x1="0" y1="0" x2="24" y2="24">
					<stop stop-color="#a78bfa"></stop>
					<stop offset="1" stop-color="#7c3aed"></stop>
				</linearGradient>
			</defs>
		</svg>
	</span>
	StackDNA
</div>
