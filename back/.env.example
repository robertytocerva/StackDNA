# =============================================
# Technology Catalog API - Variables de Entorno
# =============================================

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Puerto del servidor HTTP
PORT=3000

# =============================================
# Base de datos PostgreSQL
# =============================================
# Opción 1: URL de conexión completa (preferida)
DATABASE_URL=postgresql://user:password@localhost:5432/technology_catalog

# Opción 2: Variables individuales (usadas si DATABASE_URL no está definida)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=technology_catalog
# DB_USER=user
# DB_PASSWORD=password

# =============================================
# Token de acceso a GitHub (opcional)
# Sin token: 60 req/hora. Con token: 5000 req/hora
# =============================================
GITHUB_TOKEN=

# =============================================
# TTL de caché por fuente (en segundos)
# =============================================
# APIs.guru - default: 86400 (24 horas)
CACHE_TTL_APIS_GURU=86400

# npm Registry - default: 21600 (6 horas)
CACHE_TTL_NPM=21600

# PyPI - default: 21600 (6 horas)
CACHE_TTL_PYPI=21600

# GitHub - default: 43200 (12 horas)
CACHE_TTL_GITHUB=43200
