{
  "name": "technology-catalog-api",
  "version": "1.0.0",
  "type": "module",
  "description": "API REST que agrega información de tecnologías desde múltiples fuentes externas",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "tsx src/app.ts",
    "migrate": "tsx src/migrations/runner.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:unit": "vitest --run tests/unit",
    "test:integration": "vitest --run tests/integration",
    "test:property": "vitest --run tests/property"
  },
  "dependencies": {
    "axios": "1.7.9",
    "axios-retry": "4.5.0",
    "bottleneck": "2.19.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "pg": "8.13.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "fast-check": "3.22.0",
    "supertest": "7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "5.4.5",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
